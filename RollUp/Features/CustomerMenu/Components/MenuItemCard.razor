@using RollUp.Core.Models

<div @onclick="() => OnAddToCart.InvokeAsync(Item)" 
     class="@GetCardClass()">
    <div class="relative w-24 h-24 flex-shrink-0 rounded-xl overflow-hidden">
        <img src="@Item.ImageUrl" alt="@Item.Name" class="w-full h-full object-cover" />
        @if (!Item.IsAvailable)
        {
            <div class="absolute inset-0 bg-black/60 flex items-center justify-center">
                <span class="text-white text-xs font-semibold">Sold Out</span>
            </div>
        }
        @if (Item.IsPopular && Item.IsAvailable)
        {
            <div class="absolute top-1 left-1 bg-cafe-caramel text-white text-xs px-2 py-0.5 rounded-full">
                Popular
            </div>
        }
    </div>
    
    <div class="flex-1 min-w-0">
        <div class="flex items-start justify-between gap-2">
            <h3 class="font-medium text-cafe-espresso truncate">@Item.Name</h3>
            <span class="font-semibold text-cafe-caramel whitespace-nowrap">$@Item.Price.ToString("F2")</span>
        </div>
        <p class="text-sm text-gray-500 line-clamp-2 mt-1">@Item.Description</p>
        @if (Item.Tags.Any())
        {
            <div class="flex flex-wrap gap-1 mt-2">
                @foreach (var tag in Item.Tags.Take(4))
                {
                    <span class="px-2 py-0.5 bg-stone-100 text-stone-600 text-[10px] uppercase tracking-wider font-semibold rounded-md border border-stone-200">@tag</span>
                }
            </div>
        }
    </div>
    
    <button class="@GetButtonClass()" disabled="@(!Item.IsAvailable)">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
    </button>
</div>

@code {
    [Parameter]
    public MenuItem Item { get; set; } = new();

    [Parameter]
    public EventCallback<MenuItem> OnAddToCart { get; set; }

    private string GetCardClass()
    {
        var baseClass = "flex items-center gap-4 p-3 bg-white rounded-2xl shadow-sm transition-all cursor-pointer ";
        return Item.IsAvailable
            ? baseClass + "hover:shadow-md hover:scale-[1.01]"
            : baseClass + "opacity-60";
    }

    private string GetButtonClass()
    {
        var baseClass = "flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center transition-colors ";
        return Item.IsAvailable
            ? baseClass + "bg-cafe-espresso text-white hover:bg-cafe-mocha"
            : baseClass + "bg-gray-200 text-gray-400 cursor-not-allowed";
    }
}
