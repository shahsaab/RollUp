@page "/"

<PageTitle>Scandish - Cafe Management</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-cafe-cream via-white to-cafe-latte/30 flex items-center justify-center p-6">
    <div class="max-w-4xl w-full">
        <div class="text-center mb-12">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-cafe-espresso rounded-2xl mb-6 shadow-xl">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" d="M2.625 6.75a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zm4.875 0A.75.75 0 018.25 6h12a.75.75 0 010 1.5h-12a.75.75 0 01-.75-.75zM2.625 12a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zM7.5 12a.75.75 0 01.75-.75h12a.75.75 0 010 1.5h-12A.75.75 0 017.5 12zm-4.875 5.25a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zm4.875 0a.75.75 0 01.75-.75h12a.75.75 0 010 1.5h-12a.75.75 0 01-.75-.75z" clip-rule="evenodd" />
                </svg>
            </div>
            <h1 class="font-display text-5xl font-bold text-cafe-espresso mb-4">Scandish</h1>
            <p class="text-xl text-cafe-mocha">Cafe Management System</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
            <!-- Customer Menu -->
            <a href="/menu" class="group">
                <div class="bg-white rounded-2xl p-8 shadow-lg border border-stone-200 hover:shadow-xl hover:border-cafe-caramel transition-all hover:-translate-y-1">
                    <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-500 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-blue-600 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
                            <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <h2 class="text-xl font-semibold text-cafe-espresso mb-2">Customer Menu</h2>
                    <p class="text-stone-500 mb-4">QR code menu for customers to browse and place orders from their phones.</p>
                    <div class="flex items-center text-cafe-caramel font-medium">
                        <span>Open Menu</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </div>
                </div>
            </a>

            <!-- Queue Display -->
            <a href="/queue" class="group">
                <div class="bg-white rounded-2xl p-8 shadow-lg border border-stone-200 hover:shadow-xl hover:border-cafe-caramel transition-all hover:-translate-y-1">
                    <div class="w-14 h-14 bg-emerald-100 rounded-xl flex items-center justify-center mb-6 group-hover:bg-emerald-500 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-emerald-600 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
                            <path fill-rule="evenodd" d="M2.25 5.25a3 3 0 013-3h13.5a3 3 0 013 3V15a3 3 0 01-3 3h-3v.257c0 .597.237 1.17.659 1.591l.621.622a.75.75 0 01-.53 1.28h-9a.75.75 0 01-.53-1.28l.621-.622a2.25 2.25 0 00.659-1.59V18h-3a3 3 0 01-3-3V5.25zm1.5 0v7.5a1.5 1.5 0 001.5 1.5h13.5a1.5 1.5 0 001.5-1.5v-7.5a1.5 1.5 0 00-1.5-1.5H5.25a1.5 1.5 0 00-1.5 1.5z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <h2 class="text-xl font-semibold text-cafe-espresso mb-2">Queue Display</h2>
                    <p class="text-stone-500 mb-4">LED/TV display for customers to see their order status in real-time.</p>
                    <div class="flex items-center text-cafe-caramel font-medium">
                        <span>Open Display</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </div>
                </div>
            </a>

            <!-- Kitchen Queue -->
            <a href="/kitchen" class="group">
                <div class="bg-white rounded-2xl p-8 shadow-lg border border-stone-200 hover:shadow-xl hover:border-cafe-caramel transition-all hover:-translate-y-1">
                    <div class="w-14 h-14 bg-amber-100 rounded-xl flex items-center justify-center mb-6 group-hover:bg-amber-500 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-amber-600 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12.378 1.602a.75.75 0 00-.756 0L3 6.632l9 5.25 9-5.25-8.622-5.03zM21.75 7.93l-9 5.25v9l8.628-5.032a.75.75 0 00.372-.648V7.93zM11.25 22.18v-9l-9-5.25v8.57a.75.75 0 00.372.648l8.628 5.033z" />
                        </svg>
                    </div>
                    <h2 class="text-xl font-semibold text-cafe-espresso mb-2">Kitchen Queue</h2>
                    <p class="text-stone-500 mb-4">Kanban-style order management for kitchen staff to track and update orders.</p>
                    <div class="flex items-center text-cafe-caramel font-medium">
                        <span>Open Kitchen</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </div>
                </div>
            </a>
        </div>

        <!-- Menu Management Link -->
        <div class="mt-8 text-center">
            <a href="/manage" class="inline-flex items-center gap-2 px-6 py-3 bg-cafe-espresso text-white rounded-xl hover:bg-cafe-mocha transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Menu Management
            </a>
        </div>

        <div class="mt-12 text-center text-stone-400 text-sm">
            <p>Cafe Management System - Built with Blazor Server</p>
        </div>
    </div>
</div>

