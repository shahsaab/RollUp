<div class="sticky top-[73px] z-30 bg-cafe-cream/95 backdrop-blur-sm border-b border-cafe-latte/30">
    <div class="max-w-lg mx-auto">
        <div class="flex overflow-x-auto scrollbar-hide gap-2 px-4 py-3">
            @foreach (var category in Categories)
            {
                <button @onclick="() => OnCategorySelected.InvokeAsync(category)"
                        class="@GetCategoryClass(category)">
                    @category
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public List<string> Categories { get; set; } = new();
    [Parameter] public string SelectedCategory { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnCategorySelected { get; set; }

    private string GetCategoryClass(string category)
    {
        var baseClass = "px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap transition-colors ";
        return category == SelectedCategory
            ? baseClass + "bg-cafe-espresso text-white"
            : baseClass + "bg-white text-cafe-mocha hover:bg-cafe-latte";
    }
}
